# OpenAI API Key for the LLM
OPENAI_API_KEY=sk-your-openai-api-key

# Kapa project configuration
# Create an API key under Deploy > API Keys in the Kapa platform
KAPA_API_KEY=your-kapa-api-key

# Copy the project ID from Settings > Projects in the Kapa platform
KAPA_PROJECT_ID=your-project-id

# Your product name - used in the system prompt and agent responses
PRODUCT_NAME=My Awesome Product

